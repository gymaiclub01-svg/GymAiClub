---
import { Image } from 'astro:assets';
import { t, type Lang } from '../i18n/utils';
import { APP_STORE_URL } from '../config';
import cameraShot from '../assets/screenshots/camera.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---
<header class="hero wrap">
  <div class="hero-glow"></div>
  <div style="position:relative; z-index:2; transform:translateY(-30px);">
    <h1>{t(lang, 'hero.title_1')}<br>{t(lang, 'hero.title_2')} <span class="g">{t(lang, 'hero.title_accent')}</span></h1>
    <p class="lead">{t(lang, 'hero.lead')}</p>
    <div class="store-row">
      <a href={APP_STORE_URL} target="_blank" rel="noopener" class="store-btn btn-hover" style="background:#fff; color:#0B0D08;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="#0B0D08" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84c1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09M12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
        <div style="text-align:left;"><small>{t(lang, 'hero.download_label')}</small><strong>App Store</strong></div>
      </a>
      <span class="soon-note">{t(lang, 'hero.android_soon')}</span>
    </div>
    <div class="stats">
      <div><div class="num">{t(lang, 'hero.stats.exercises_value')}</div><div class="lbl">{t(lang, 'hero.stats.exercises_label')}</div></div>
      <div class="sep"></div>
      <div><div class="num">{t(lang, 'hero.stats.accuracy_value')}</div><div class="lbl">{t(lang, 'hero.stats.accuracy_label')}</div></div>
      <div class="sep"></div>
      <div><div class="num">{t(lang, 'hero.stats.rating_value')}<span style="color:var(--color-brand-gold); font-size:18px;"> ★</span></div><div class="lbl">{t(lang, 'hero.stats.rating_label')}</div></div>
    </div>
  </div>
  <div style="position:relative; z-index:2; display:flex; justify-content:center; transform:translateY(-10px);">
    <div style="position:absolute; width:340px; height:340px; background:radial-gradient(circle, rgba(215,255,63,.22), transparent 62%); animation:gaiwGlow 4s ease-in-out infinite;"></div>
    <div style="position:relative; animation:gaiwFloat 6s ease-in-out infinite;">
      <div class="phone-shell"><div class="screen"><Image src={cameraShot} alt={t(lang, 'showcase.slides.4.title')} width={320} densities={[1, 2, 3]} /></div></div>
    </div>
  </div>
</header>
