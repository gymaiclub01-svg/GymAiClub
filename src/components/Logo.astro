---
import { Image } from 'astro:assets';
import mark from '../assets/logo-mark.png';

interface Props {
  size?: number;
  glow?: boolean;
}
/** `size` = amblemin yüksekliği; genişlik en-boy oranından hesaplanır. */
const { size = 34, glow = true } = Astro.props;
const height = size;
const width = Math.round((size * mark.width) / mark.height);
---
<Image
  src={mark}
  alt=""
  width={width}
  height={height}
  densities={[1, 2, 3]}
  style={glow ? 'filter:drop-shadow(0 0 8px rgba(215,255,63,.45));' : undefined}
/>
