---
import Logo from './Logo.astro';
import { t, type Lang } from '../i18n/utils';
import { APP_STORE_URL } from '../config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---
<section id="download" class="wrap" style="padding-bottom:100px;">
  <div class="cta-box">
    <div class="cglow"></div>
    <div style="position:relative; z-index:2;">
      <div style="margin-bottom:24px; display:flex; justify-content:center;"><Logo size={54} /></div>
      <h2>{t(lang, 'cta.title')}</h2>
      <p>{t(lang, 'cta.sub')}</p>
      <div class="store-row" style="justify-content:center;">
        <a href={APP_STORE_URL} target="_blank" rel="noopener" class="store-btn btn-hover" style="background:var(--color-brand-green); color:var(--color-brand-ink); padding:15px 26px; box-shadow:0 0 30px rgba(215,255,63,.4);">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="var(--color-brand-ink)" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84c1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09M12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
          <div style="text-align:left;"><small>{t(lang, 'cta.download_label')}</small><strong style="font-size:17px;">App Store</strong></div>
        </a>
      </div>
    </div>
  </div>
</section>
