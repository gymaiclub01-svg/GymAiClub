---
import Logo from './Logo.astro';
import { t, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---
<section id="download" class="wrap" style="padding-bottom:100px;">
  <div class="cta-box">
    <div class="cglow"></div>
    <div style="position:relative; z-index:2;">
      <div style="margin-bottom:24px; display:flex; justify-content:center;"><Logo size={54} /></div>
      <h2>{t(lang, 'cta.title')}</h2>
      <p>{t(lang, 'cta.sub')}</p>
      <div class="store-row" style="justify-content:center;">
        <a href="#top" class="store-btn btn-hover" style="background:#fff; color:var(--color-brand-ink); padding:15px 26px;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="var(--color-brand-ink)" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84c1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09M12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
          <div style="text-align:left;"><small>{t(lang, 'cta.download_label')}</small><strong style="font-size:17px;">App Store</strong></div>
        </a>
        <a href="#top" class="store-btn btn-hover" style="background:var(--color-brand-green); color:var(--color-brand-ink); padding:15px 26px; box-shadow:0 0 30px rgba(215,255,63,.4);">
          <svg width="24" height="24" viewBox="0 0 512 512" fill="none" aria-hidden="true"><path d="M47.6 9.5C41.2 16.3 37.5 26.9 37.5 40.6v430.8c0 13.7 3.7 24.3 10.1 31.1L49 504l241.3-241.3v-5.7L49 15.7l-1.4-6.2z" fill="var(--color-brand-ink)"/><path d="M370.7 343.4l-80.4-80.5v-5.7l80.5-80.5 1.8 1 95.3 54.2c27.2 15.5 27.2 40.7 0 56.2l-95.3 54.2-1.9 1.1z" fill="var(--color-brand-ink)"/><path d="M372.6 342.3l-82.3-82.3L47.6 502.5c9 9.5 23.7 10.6 40.3 1.2l284.7-161.4z" fill="var(--color-brand-ink)"/><path d="M372.6 177.7L87.9 16.4C71.3 7 56.6 8.1 47.6 17.6l242.7 242.4 82.3-82.3z" fill="var(--color-brand-ink)"/></svg>
          <div style="text-align:left;"><small>{t(lang, 'cta.download_label')}</small><strong style="font-size:17px;">Google Play</strong></div>
        </a>
      </div>
    </div>
  </div>
</section>
